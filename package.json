    "serverless-certificate-creator": "1.6.0",
    "serverless-domain-manager": "6.2.1",
    "serverless-export-env": "2.2.0",
    "serverless-offline": "14.8.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.1",
