    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/lib-dynamodb": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@middy/core": "6.4.5",
    "@middy/http-cors": "6.4.5",
    "@middy/http-error-handler": "6.4.5",
    "@middy/http-json-body-parser": "6.4.5",
    "@middy/http-security-headers": "6.4.5",
    "@middy/validator": "6.4.5",
    "aws-lambda": "1.0.7",
    "axios": "1.7.9",
    "http-errors": "2.0.0",
    "jose": "5.10.0"
